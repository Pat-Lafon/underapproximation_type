let rec even_list_gen = fun s ->
  let (xccc2) = sizecheck s in
  match xccc2 with
  | true ->
      let (idx0ccc5) = Nil in
      let (idx1ccc1) = int_gen () in idx1ccc1 :: idx0ccc5
  | false ->
      let (idx20) = bool_gen () in
      (match idx20 with
       | true ->
           let (idx0ccc3) = Nil in
           let (idx1ccc0) = int_gen () in idx1ccc0 :: idx0ccc3
       | false ->
           let (idx2ccc0) = s in
           let (idx5ccc0) = subs idx2ccc0 in
           let (idx9ccc2) = even_list_gen idx5ccc0 in
           let (idx1ccc0) = int_gen () in idx1ccc0 :: idx9ccc2)