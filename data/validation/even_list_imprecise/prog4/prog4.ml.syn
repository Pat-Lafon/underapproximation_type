let rec even_list_gen = fun s ->
  let (xccc7) = sizecheck s in
  match xccc7 with
  | true ->
      let (idx0ccc5) = Nil in
      let (idx1ccc1) = int_gen () in idx1ccc1 :: idx0ccc5
  | false ->
      let (idx4) = bool_gen () in
      (match idx4 with
       | true ->
           let (xccc8) = subs s in
           let (xccc9) = even_list_gen xccc8 in
           let (xccc10) = int_gen () in
           let (xccc11) = double xccc10 in xccc11 :: xccc9
       | false ->
           let (idx2ccc0) = s in
           let (idx5ccc0) = subs idx2ccc0 in even_list_gen idx5ccc0)