let rec even_list_gen = fun s ->
  let (xccc6) = sizecheck s in
  match xccc6 with
  | true ->
      let (idx0ccc3) = Nil in
      let (idx1ccc0) = int_gen () in idx1ccc0 :: idx0ccc3
  | false ->
      let (idx4) = bool_gen () in
      (match idx4 with
       | true ->
           let (xccc7) = [] in
           let (xccc8) = int_gen () in
           let (xccc9) = double xccc8 in xccc9 :: xccc7
       | false ->
           let (idx2ccc1) = s in
           let (idx7ccc0) = subs idx2ccc1 in
           let (idx10ccc2) = even_list_gen idx7ccc0 in
           let (idx1ccc1) = int_gen () in idx1ccc1 :: idx10ccc2)