let rec even_list_gen = fun s ->
  let (xccc6) = sizecheck s in
  match xccc6 with
  | true ->
      let (xccc7) = [] in
      let (xccc8) = int_gen () in
      let (xccc9) = double xccc8 in xccc9 :: xccc7
  | false ->
      let (idx14) = bool_gen () in
      (match idx14 with
       | true ->
           let (idx0ccc2) = Nil in
           let (idx1ccc0) = int_gen () in idx1ccc0 :: idx0ccc2
       | false ->
           let (idx2ccc0) = s in
           let (idx5ccc0) = subs idx2ccc0 in
           let (idx7ccc2) = even_list_gen idx5ccc0 in
           let (idx1ccc0) = int_gen () in idx1ccc0 :: idx7ccc2)