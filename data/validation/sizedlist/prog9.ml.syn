let rec sized_list_gen = fun s ->
  let (xccc2) = sizecheck s in
  match xccc2 with
  | True -> Nil
  | False ->
      let (_x14) = bool_gen () in
      (match _x14 with
       | True ->
           let (_x2) = s in
           let (_x5) = subs _x2 in
           let (ccc7) = sized_list_gen _x5 in
           let (ccc3) = int_gen () in Cons (ccc3, ccc7)
       | False -> Nil)