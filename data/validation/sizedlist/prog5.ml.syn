let rec sized_list_gen = fun s ->
  let (xccc3) = sizecheck s in
  match xccc3 with
  | True -> []
  | False ->
      let (_x15) = bool_gen () in
      (match _x15 with
       | True ->
           let (_x2) = s in
           let (_x6) = subs _x2 in
           let (ccc15) = sized_list_gen _x6 in
           let (ccc11) = int_gen () in Cons (ccc11, ccc15)
       | False -> Nil)