let rec complete_tree_gen = fun s ->
  let (xccc2) = sizecheck s in
  match xccc2 with
  | True -> Leaf
  | False ->
      let (idx0) = Leaf in
      let (idx2) = s in
      let (idx5ccc0) = subs idx2 in
      let (idx7ccc2) = complete_tree_gen idx5ccc0 in
      let (idx1ccc0) = int_gen () in Node (idx1ccc0, idx7ccc2, idx0)