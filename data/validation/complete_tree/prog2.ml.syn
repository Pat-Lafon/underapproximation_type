let rec complete_tree_gen = fun s ->
  let (x_2) = sizecheck s in
  match x_2 with
  | True -> Leaf
  | False ->
      let (_x2) = s in
      let (_x5) = subs _x2 in
      let (_18) = complete_tree_gen _x5 in
      let (_16) = complete_tree_gen _x5 in
      let (_2) = int_gen () in Node (_2, _16, _18)