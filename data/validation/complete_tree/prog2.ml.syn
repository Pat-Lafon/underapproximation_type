let rec complete_tree_gen = fun s ->
  let (xccc2) = sizecheck s in
  match xccc2 with
  | True -> Leaf
  | False ->
      let (_x2) = s in
      let (_x5) = subs _x2 in
      let (ccc10) = complete_tree_gen _x5 in
      let (ccc8) = complete_tree_gen _x5 in
      let (ccc2) = int_gen () in Node (ccc2, ccc8, ccc10)