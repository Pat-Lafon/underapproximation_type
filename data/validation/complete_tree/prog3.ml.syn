let rec complete_tree_gen = fun s ->
  let (x_2) = sizecheck s in
  match x_2 with
  | True -> Leaf
  | False ->
      let (_x2) = s in
      let (_x5) = subs _x2 in
      let (_19) = complete_tree_gen _x5 in
      let (_17) = complete_tree_gen _x5 in
      let (_3) = int_gen () in Node (_3, _17, _19)