let rec sorted_list_gen = fun s ->
  fun x ->
    let (xccc3) = sizecheck s in
    match xccc3 with
    | True -> Nil
    | False ->
        let (y) = int_gen () in
        let (xccc4) = x <= y in
        (match xccc4 with
         | True ->
             let (_x1) = s in
             let (_x8) = subs _x1 in
             let (_x12) = sorted_list_gen _x8 in
             let (ccc86) = _x12 y in Cons (y, ccc86)
         | False -> Err)