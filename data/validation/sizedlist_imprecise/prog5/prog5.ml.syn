let rec sized_list_gen = fun s ->
  let (xccc3) = sizecheck s in
  match xccc3 with
  | true -> []
  | false ->
      let (idx10) = bool_gen () in
      (match idx10 with
       | true ->
           let (idx1ccc0) = s in
           let (idx5ccc0) = subs idx1ccc0 in
           let (idx7ccc2) = sized_list_gen idx5ccc0 in
           let (idx0ccc0) = int_gen () in idx0ccc0 :: idx7ccc2
       | false ->
           let (idx1ccc0) = s in
           let (idx5ccc0) = subs idx1ccc0 in sized_list_gen idx5ccc0)