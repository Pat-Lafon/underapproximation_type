let rec sized_list_gen = fun s ->
  let (xccc3) = sizecheck s in
  match xccc3 with
  | true -> hidden_list_gen ()
  | false ->
      let (idx13) = bool_gen () in
      (match idx13 with
       | true ->
           let (idx1ccc0) = s in
           let (idx5ccc0) = subs idx1ccc0 in
           let (idx9ccc2) = sized_list_gen idx5ccc0 in
           let (idx0ccc0) = int_gen () in idx0ccc0 :: idx9ccc2
       | false ->
           let (idx1ccc0) = s in
           let (idx5ccc0) = subs idx1ccc0 in sized_list_gen idx5ccc0)