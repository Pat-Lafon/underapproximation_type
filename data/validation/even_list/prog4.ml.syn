let rec even_list_gen = fun s ->
  let (xccc7) = sizecheck s in
  match xccc7 with
  | true ->
      let (idx0ccc9) = Nil in
      let (idx1ccc1) = int_gen () in
      let (idx16ccc0) = double idx1ccc1 in idx16ccc0 :: idx0ccc9
  | false ->
      let (idx4) = bool_gen () in
      (match idx4 with
       | true ->
           let (xccc8) = subs s in
           let (xccc9) = even_list_gen xccc8 in
           let (xccc10) = int_gen () in
           let (xccc11) = double xccc10 in xccc11 :: xccc9
       | false ->
           let (idx0ccc6) = Nil in
           let (idx1ccc0) = int_gen () in
           let (idx14ccc0) = double idx1ccc0 in idx14ccc0 :: idx0ccc6)