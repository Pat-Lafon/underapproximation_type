let rec even_list_gen = fun s ->
  let (xccc6) = sizecheck s in
  match xccc6 with
  | true ->
      let (xccc7) = [] in
      let (xccc8) = int_gen () in
      let (xccc9) = double xccc8 in xccc9 :: xccc7
  | false ->
      let (idx71) = bool_gen () in
      (match idx71 with
       | true ->
           let (idx2ccc0) = s in
           let (idx5ccc0) = subs idx2ccc0 in
           let (idx17ccc3) = even_list_gen idx5ccc0 in
           let (idx1ccc0) = int_gen () in
           let (idx10ccc0) = double idx1ccc0 in idx10ccc0 :: idx17ccc3
       | false ->
           let (idx0ccc3) = Nil in
           let (idx1ccc0) = int_gen () in
           let (idx10ccc0) = double idx1ccc0 in idx10ccc0 :: idx0ccc3)