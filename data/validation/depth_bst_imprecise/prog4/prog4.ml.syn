let rec size_bst_gen = fun d ->
  fun lo ->
    fun hi ->
      let (xccc6) = sizecheck d in
      match xccc6 with
      | true -> Leaf
      | false ->
          let (xccc7) = incr lo in
          let (xccc8) = xccc7 < hi in
          (match xccc8 with
           | true ->
               let (xccc9) = int_range lo in
               let (x) = xccc9 hi in
               let (idx6) = bool_gen () in
               (match idx6 with
                | true -> Leaf
                | false ->
                    let (idx1ccc2) = hidden_tree_gen () in
                    let (idx1ccc1) = hidden_tree_gen () in
                    let (idx9) = x in Node (idx9, idx1ccc1, idx1ccc2))
           | false -> Leaf)